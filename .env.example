NODE_ENV=development
PORT=3000
API_PREFIX=/api
DATABASE_URL="postgresql://salesguard:salesguard@localhost:5432/salesguard?schema=public"
JWT_SECRET=change-this-jwt-secret-in-production

# Google OAuth
# Leave success/failure redirects empty if the backend should respond with JSON.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTH_SUCCESS_REDIRECT=
GOOGLE_AUTH_FAILURE_REDIRECT=

# Email notifications
# Leave EMAIL_HOST empty to keep the demo email mode in console logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=salesguard@example.com

# Real OAuth credentials belong in local .env files or in Render environment variables.
