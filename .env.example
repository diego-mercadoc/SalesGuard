NODE_ENV=development
PORT=3000
API_PREFIX=/api
JWT_SECRET=super-secret-jwt-key
DATABASE_URL="postgresql://salesguard:salesguard@localhost:5432/salesguard?schema=public"

# Google OAuth configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_AUTH_SUCCESS_REDIRECT=http://localhost:3000/demo/
GOOGLE_AUTH_FAILURE_REDIRECT=http://localhost:3000/demo/

# Optional email configuration for anomaly notifications
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=salesguard@example.com
